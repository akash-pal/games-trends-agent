# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` only if you need to change something.
#   cp .env.example .env
# NEVER commit the real .env file — it's already in .gitignore.
# The project runs with no keys at all.
# ─────────────────────────────────────────────────────────────

# ── Ollama (local model) ──
# Leave OLLAMA_MODEL unset to use your only installed model. If you have
# several, set the one to use. See what you have with:  ollama list
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_HOST=127.0.0.1:11434

# ── Reddit (optional, recommended for CI) ──
# Public endpoints are often blocked from GitHub Actions IPs, so for reliable
# scheduled runs create a "script" app at https://www.reddit.com/prefs/apps
# and fill these in. Leave as-is to use public endpoints only.
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
